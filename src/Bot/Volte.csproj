<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RuntimeIdentifiers>linux-x64;win-x64;linux-arm64</RuntimeIdentifiers>
        <Authors>GreemDev</Authors>
        <Company>Polyhaze</Company>
        <PackageProjectUrl>https://github.com/Polyhaze/Volte</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Polyhaze/Volte</RepositoryUrl>
        <Copyright>MIT</Copyright>
        <Version>4.0.0.0</Version> <!-- actual version number -->
        <Platforms>AnyCPU</Platforms>
        <ApplicationIcon>Resources/Volte.ico</ApplicationIcon>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefineConstants Condition=" '$(ExtraDefineConstants)' != '' ">$(DefineConstants);$(ExtraDefineConstants)</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="Resources/VolteIcon.png" LogicalName="VolteIcon" />
        <EmbeddedResource Include="Resources/Mono/JetBrainsMonoNL-Regular.ttf" LogicalName="Regular" />
        <EmbeddedResource Include="Resources/Mono/JetBrainsMonoNL-Bold.ttf" LogicalName="Bold" />
        <EmbeddedResource Include="Resources/Mono/JetBrainsMonoNL-BoldItalic.ttf" LogicalName="BoldItalic" />
        <EmbeddedResource Include="Resources/Mono/JetBrainsMonoNL-Italic.ttf" LogicalName="Italic" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Discord.Net.Interactions" Version="3.18.0" />
        <PackageReference Include="Discord.Net.WebSocket" Version="3.18.0" />
        <PackageReference Include="Gommon" Version="2.7.1.3" />
        <PackageReference Include="GreemDev.Colorful.Console" Version="1.3.2" />
        <PackageReference Include="Humanizer.Core" Version="2.14.1" />
        <PackageReference Include="LiteDB" Version="5.0.21" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
        <PackageReference Include="Qmmands" Version="5.0.2" />        
        <PackageReference Include="Sentry" Version="5.14.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
        <PackageReference Include="Starscript.Net" Version="1.0.43" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Resources\" />
    </ItemGroup>
</Project>